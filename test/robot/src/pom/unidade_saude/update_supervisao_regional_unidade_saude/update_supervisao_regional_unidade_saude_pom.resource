*** Settings ***
Resource    ../../common/mais_saude_publica_common.resource
# ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
*** Comments ***
# ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
*** Variables ***
${UNIDADE_SAUDE_ENDPOINT}        /unidade-saude
${CONTENT_TYPE}    application/json
# ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
*** Keywords ***
PATCH Update Supervisao Regional Unidade Saude
    [Documentation]    Sends a PATCH request to update a Unidade de Saúde unit's lateral supervisaoRegional
    ...    link (a REGIONAL unit's nome) and returns the response.
    [Arguments]    ${nome}    ${payload}
    # ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════
    Get Mais Saude Publica Session

    ${headers}=    Create Dictionary
    ...    Content-Type=${CONTENT_TYPE}

    ${response}=    PATCH On Session
    ...    msp_session
    ...    ${BASE_URL}${UNIDADE_SAUDE_ENDPOINT}/supervisao-regional/${nome}
    ...    json=${payload}
    ...    headers=${headers}
    ...    expected_status=ANY

    Log    ${response.status_code}
    Log    ${response.text}

    RETURN    ${response}
    # ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════
# ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

PATCH Update Supervisao Regional Unidade Saude - Raw Body
    [Documentation]    Sends a PATCH request with a raw (possibly malformed) string body, bypassing JSON
    ...    serialization — used to exercise HttpMessageNotReadableException (AQUAQE-215).
    [Arguments]    ${nome}    ${rawBody}
    # ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════
    Get Mais Saude Publica Session

    ${headers}=    Create Dictionary
    ...    Content-Type=${CONTENT_TYPE}

    ${response}=    PATCH On Session
    ...    msp_session
    ...    ${BASE_URL}${UNIDADE_SAUDE_ENDPOINT}/supervisao-regional/${nome}
    ...    data=${rawBody}
    ...    headers=${headers}
    ...    expected_status=ANY

    Log    ${response.status_code}
    Log    ${response.text}

    RETURN    ${response}
    # ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════
# ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
