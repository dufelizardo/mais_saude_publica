${CICLO_AVALIACAO_ENDPOINT}    /ciclo-avaliacao
# ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
*** Keywords ***
POST Create Ciclo Avaliacao
    [Documentation]    Sends a POST request to ${BASE_URL}${CICLO_AVALIACAO_ENDPOINT}/ and returns the response.
    [Arguments]    ${payload}
    # ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════
    Get Mais Saude Publica Session
    ${headers}=    Create Dictionary    Content-Type=application/json
    ${response}=    POST On Session    msp_session    ${BASE_URL}${CICLO_AVALIACAO_ENDPOINT}/    json=${payload}    headers=${headers}    expected_status=ANY
    Log    ${response.status_code}
    Log    ${response.text}
    RETURN    ${response}
    # ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════
# ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

