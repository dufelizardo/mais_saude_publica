PATCH Update Ciclo Avaliacao
    [Documentation]    Sends a PATCH request to ${BASE_URL}${CICLO_AVALIACAO_ENDPOINT}/${uuid} and returns the response.
    [Arguments]    ${uuid}    ${payload}
    # ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════
    Get Mais Saude Publica Session
    ${headers}=    Create Dictionary    Content-Type=application/json
    ${response}=    PATCH On Session    msp_session    ${BASE_URL}${CICLO_AVALIACAO_ENDPOINT}/${uuid}    json=${payload}    headers=${headers}    expected_status=ANY
    Log    ${response.status_code}
    Log    ${response.text}
    RETURN    ${response}
