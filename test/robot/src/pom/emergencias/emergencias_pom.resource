POST Evento Emergencial
    [Documentation]    Registers the emergency event.
    [Arguments]    ${payload}
    # ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════
    Get Mais Saude Publica Session
    ${response}=    POST On Session    msp_session    ${BASE_URL}/evento-emergencial    json=${payload}    expected_status=ANY
    RETURN    ${response}
    # ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════
# ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

POST Situacao Evento Emergencial
    [Documentation]    Monitors or discards the event.
    [Arguments]    ${evento}    ${payload}
