*** Settings ***
Resource    ../common/mais_saude_publica_common.resource
# ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
*** Comments ***
    As pessoas na emergência (ADR-0193): vulneráveis, deslocados e o aviso do prontuário.
# ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
*** Variables ***
# ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
*** Keywords ***
POST Pessoas Emergencia
    [Documentation]    Posts to /api/v1/{rota}: emergencia/{id}/deslocado and the actions on it.
    [Arguments]    ${rota}    ${payload}
    # ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════
    Get Mais Saude Publica Session
    ${headers}=    Create Dictionary    Content-Type=application/json
    ${response}=    Post On Session    msp_session    ${BASE_URL}/${rota}    json=${payload}    headers=${headers}    expected_status=ANY
    Log    ${response.status_code}
    Log    ${response.text}
    RETURN    ${response}
    # ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════
# ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

PUT Pessoas Emergencia
    [Documentation]    Puts to /api/v1/{rota}: emergencia/{id}/territorio and the transport link.
    [Arguments]    ${rota}    ${payload}
    # ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════
    Get Mais Saude Publica Session
    ${headers}=    Create Dictionary    Content-Type=application/json
    ${response}=    Put On Session    msp_session    ${BASE_URL}/${rota}    json=${payload}    headers=${headers}    expected_status=ANY
    Log    ${response.status_code}
    RETURN    ${response}
    # ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════
# ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

GET Pessoas Emergencia
    [Documentation]    Gets /api/v1/{rota}: vulneraveis, vulneraveis.csv, deslocados, emergencias/deslocamentos.
    [Arguments]    ${rota}
    # ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════
    Get Mais Saude Publica Session
    ${response}=    GET On Session    msp_session    ${BASE_URL}/${rota}    expected_status=ANY
    Log    ${response.status_code}
    RETURN    ${response}
    # ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════
# ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
