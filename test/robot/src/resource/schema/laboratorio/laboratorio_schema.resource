*** Comments ***
    Mais Saúde Pública API - Laboratório assistencial (ADR-0093): exame do catálogo, pedido sem valores (resumo), pedido com
    resultados, amostras e eventos (detalhe) e item da lista de trabalho.
*** Variables ***
${EXAME_LABORATORIAL_SCHEMA}    ${{{'required': ['uuid', 'nome', 'material', 'tipoResultado', 'ativo'], 'types': {'uuid': str, 'nome': str, 'material': str, 'tipoResultado': str, 'unidadeMedida': str, 'referenciaTexto': str, 'preparo': str, 'prazoDias': int, 'ativo': bool}, 'enums': {'material': ['SANGUE', 'URINA', 'FEZES', 'SECRECAO', 'OUTRO'], 'tipoResultado': ['NUMERICO', 'TEXTO']}}}}
${PEDIDO_EXAME_RESUMO_SCHEMA}    ${{{'required': ['uuid', 'pacienteId', 'unidadeSolicitanteId', 'prioridade', 'solicitadoEm', 'situacao', 'totalExames', 'liberados', 'itens'], 'types': {'uuid': str, 'pacienteId': str, 'pacienteNome': str, 'unidadeSolicitanteId': str, 'prioridade': str, 'solicitadoEm': str, 'situacao': str, 'totalExames': int, 'liberados': int, 'itens': list}, 'enums': {'prioridade': ['ROTINA', 'URGENTE'], 'situacao': ['AGUARDANDO_COLETA', 'EM_ANDAMENTO', 'CONCLUIDO', 'CANCELADO']}}}}
${PEDIDO_EXAME_SCHEMA}    ${{{'required': ['uuid', 'pacienteId', 'situacao', 'itens', 'indicacaoClinica', 'amostras', 'eventos'], 'types': {'uuid': str, 'situacao': str, 'itens': list, 'indicacaoClinica': str, 'cid': str, 'amostras': list, 'eventos': list}}}}
${ITEM_TRABALHO_EXAME_SCHEMA}    ${{{'required': ['itemId', 'pedidoId', 'pacienteId', 'exameNome', 'material', 'status', 'prioridade', 'solicitadoEm'], 'types': {'itemId': str, 'pedidoId': str, 'pacienteId': str, 'pacienteNome': str, 'exameNome': str, 'material': str, 'status': str, 'prioridade': str, 'solicitadoEm': str, 'amostraCodigo': str}, 'enums': {'status': ['SOLICITADO', 'COLETADO', 'RESULTADO_REGISTRADO', 'LIBERADO', 'CANCELADO']}}}}
