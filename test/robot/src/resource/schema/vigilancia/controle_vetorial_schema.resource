*** Comments ***
    Mais Saúde Pública API - controle de vetores (V4a, ADR-0162) animais das zoonoses (V4b, ADR-0163) e vigilância ambiental (V4c, ADR-0164).
*** Variables ***
${IMOVEL_VETORIAL_SCHEMA}    ${{{'required': ['uuid', 'tipo', 'endereco', 'microareaId', 'microareaCodigo', 'areaId', 'areaNome', 'pendente'], 'types': {'uuid': str, 'tipo': str, 'endereco': str, 'microareaId': str, 'microareaCodigo': str, 'areaId': str, 'areaNome': str, 'latitude': float, 'longitude': float, 'ultimaVistoria': str, 'ultimoResultado': str, 'pendente': bool}}}}
${VISTORIA_VETORIAL_SCHEMA}    ${{{'required': ['uuid', 'imovelId', 'data', 'cicloAno', 'cicloNumero', 'agenteMatricula', 'tipo', 'resultado', 'depositosInspecionados', 'focos'], 'types': {'uuid': str, 'imovelId': str, 'endereco': str, 'data': str, 'cicloAno': int, 'cicloNumero': int, 'agenteMatricula': str, 'agenteNome': str, 'tipo': str, 'resultado': str, 'depositosInspecionados': int, 'depositosEliminados': int, 'depositosTratados': int, 'larvicida': str, 'larvicidaGramas': float, 'focos': list}, 'enums': {'resultado': ['INSPECIONADA', 'FECHADA', 'RECUSADA'], 'tipo': ['ROTINA', 'LIRAA', 'BLOQUEIO', 'PONTO_ESTRATEGICO', 'DENUNCIA']}}}}
${INDICES_VETORIAIS_SCHEMA}    ${{{'required': ['ano', 'ciclo', 'inicio', 'fim', 'municipio', 'areas'], 'types': {'ano': int, 'ciclo': int, 'inicio': str, 'fim': str, 'municipio': dict, 'areas': list}}}}
${ANIMAL_ZOONOSES_SCHEMA}    ${{{'required': ['uuid', 'especie', 'endereco', 'emObservacao'], 'types': {'uuid': str, 'especie': str, 'nome': str, 'descricao': str, 'tutorNome': str, 'tutorTelefone': str, 'imovelId': str, 'endereco': str, 'microareaCodigo': str, 'areaNome': str, 'emObservacao': bool}, 'enums': {'especie': ['CAO', 'GATO', 'MORCEGO', 'PRIMATA', 'HERBIVORO', 'OUTRA']}}}}
${OBSERVACAO_ANIMAL_SCHEMA}    ${{{'required': ['uuid', 'animalId', 'especie', 'dataAgressao', 'inicio', 'fimPrevisto', 'vencida'], 'types': {'uuid': str, 'animalId': str, 'especie': str, 'notificacaoId': str, 'dataAgressao': str, 'inicio': str, 'fimPrevisto': str, 'desfecho': str, 'vencida': bool}}}}
${AMOSTRA_AGUA_SCHEMA}    ${{{'required': ['uuid', 'pontoId', 'pontoNome', 'tipo', 'dataColeta', 'conforme', 'naoConformidades'], 'types': {'uuid': str, 'pontoId': str, 'pontoNome': str, 'tipo': str, 'dataColeta': str, 'coliformesTotais': bool, 'ecoli': bool, 'cloroResidual': float, 'turbidez': float, 'fluor': float, 'conforme': bool, 'naoConformidades': list, 'medida': str}}}}
${RISCO_AMBIENTAL_SCHEMA}    ${{{'required': ['uuid', 'tipo', 'descricao', 'local', 'situacao'], 'types': {'uuid': str, 'tipo': str, 'descricao': str, 'local': str, 'populacaoExposta': int, 'situacao': str}, 'enums': {'situacao': ['ATIVO', 'CONTROLADO']}}}}
